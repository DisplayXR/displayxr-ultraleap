#
# Generates Allowlist.nsh: the provenance allowlist row for the provider DLL
# this installer packs. Same shape as the runtime's own
# installer/gen_allowlist_nsh.cmake and displayxr-input-template's.
#
# The runtime's provenance gate ENFORCES on Windows (ADR-054 N4b): a provider
# DLL must be Authenticode-signed or have its SHA-256 under
# HKLM\Software\DisplayXR\Trust\Allowlist (value name = lowercase hex digest,
# data = a note), or the loader refuses it. The digest is computed HERE, at
# packaging time, from the exact file the installer packs - never by hand -
# and the uninstaller removes the same row and only that row.
#
# Only DisplayXR-Ultraleap.dll gets a row: it is the only binary this
# installer ships. LeapC.dll is Ultraleap's and is never installed by us.
#
#   cmake -DDLL=<path> -DVERSION=<x.y.z> -DOUT=<Allowlist.nsh> -P gen_allowlist_nsh.cmake

if(NOT DEFINED DLL OR NOT DEFINED OUT)
    message(FATAL_ERROR "gen_allowlist_nsh.cmake: DLL and OUT are required")
endif()
if(NOT EXISTS "${DLL}")
    message(FATAL_ERROR "gen_allowlist_nsh.cmake: provider DLL missing: ${DLL} (build + install first)")
endif()
if(NOT DEFINED VERSION)
    set(VERSION "dev")
endif()

file(SHA256 "${DLL}" _hex)
string(TOLOWER "${_hex}" _hex)
get_filename_component(_name "${DLL}" NAME)
message(STATUS "allowlist: ${_name} sha256=${_hex}")

file(WRITE "${OUT}"
    "; Auto-generated by installer/gen_allowlist_nsh.cmake - do not edit.\n"
    "!define ULTRALEAP_ALLOWLIST_DIGEST \"${_hex}\"\n"
    "!macro ULTRALEAP_ALLOWLIST_WRITE\n"
    "\tWriteRegStr HKLM \"Software\\DisplayXR\\Trust\\Allowlist\" \"${_hex}\" \"${_name} (DisplayXR Ultraleap installer ${VERSION})\"\n"
    "!macroend\n"
    "!macro ULTRALEAP_ALLOWLIST_REMOVE\n"
    "\tDeleteRegValue HKLM \"Software\\DisplayXR\\Trust\\Allowlist\" \"${_hex}\"\n"
    "\tDeleteRegKey /ifempty HKLM \"Software\\DisplayXR\\Trust\\Allowlist\"\n"
    "!macroend\n"
)
