; DisplayXR Ultraleap hands input-provider installer
; Copyright 2026, The DisplayXR Project
; SPDX-License-Identifier: Apache-2.0
;
; Adapted from displayxr-input-template's installer. Installs
; DisplayXR-Ultraleap.dll and registers it at
;   HKLM\Software\DisplayXR\InputProviders\ultraleap        (ProbeOrder 50)
; so the runtime's registry discovery finds it at xrCreateInstance, and writes
; the provenance allowlist row for the exact DLL it installs
; (HKLM\Software\DisplayXR\Trust\Allowlist), so an unsigned build loads.
;
; Rules it follows (runtime docs/guides/input-provider-onboarding.md, section 14):
;   - It owns ONLY its own rows and files: never another provider's row, the
;     InputProviders\Policy key, or the runtime's install directory.
;   - No install order: it installs with or without the runtime present.
;   - It releases its DLL with Restart Manager and never starts
;     displayxr-service elevated (it goes through explorer.exe).
;   - It honours /S: no modal dialog in silent mode.
;
; Two things are specific to this provider (docs/packaging.md):
;
;   1. THE RUNTIME RANGE. The provider hands the runtime raw xrt_device
;      structs, which the input plug-in ABI version does not cover (runtime
;      ADR-063). This build is verified for runtimes ${RUNTIME_MIN} to
;      ${RUNTIME_MAX} (identical shared headers, scripts/runtime_range.py).
;      When a runtime is installed and is OLDER than ${RUNTIME_MIN}, the
;      installer stops (exit code 3) unless /FORCE is given. A runtime NEWER
;      than ${RUNTIME_MAX} is "not verified by this build", not "known bad":
;      the installer says so and proceeds; the component catalog carries the
;      current verified maximum.
;
;   2. NOTHING OF ULTRALEAP'S IS INSTALLED OR COPIED. The provider binds
;      LeapC.dll at run time, by absolute path, from the user's own Ultraleap
;      tracking software. The installer only LOOKS for that software and
;      explains when it is missing; the provider then loads anyway, reports
;      its hardware absent, and starts working once the software is installed.
;
; Exit codes: 0 ok, 2 user abort, 3 installed runtime older than the minimum
; (no /FORCE).

;--------------------------------
; Build-time definitions (from installer/CMakeLists.txt):
;   VERSION, VERSION_MAJOR/MINOR/PATCH, BUILD_NUM
;   RUNTIME_PIN   - runtime release this binary was built at (e.g. 2.69.3)
;   RUNTIME_MIN   - oldest runtime with identical shared headers (e.g. 2.68.0)
;   RUNTIME_MAX   - newest runtime verified when this installer was built
;   BIN_DIR       - <prefix>/bin (the DLL lives in BIN_DIR\plugins\)
;   SOURCE_DIR    - repo root (licence)
;   OUTPUT_DIR    - where the Setup .exe is written
;   ALLOWLIST_NSH - generated by gen_allowlist_nsh.cmake

!ifndef VERSION
	!define VERSION "0.1.0"
!endif
!ifndef VERSION_MAJOR
	!define VERSION_MAJOR "0"
!endif
!ifndef VERSION_MINOR
	!define VERSION_MINOR "1"
!endif
!ifndef VERSION_PATCH
	!define VERSION_PATCH "0"
!endif
!ifndef BUILD_NUM
	!define BUILD_NUM "0"
!endif
!ifndef RUNTIME_PIN
	!error "RUNTIME_PIN is required (the runtime release the DLL was built at)"
!endif
!ifndef RUNTIME_MIN
	!error "RUNTIME_MIN is required (catalog runtime_range.min)"
!endif
!ifndef RUNTIME_MAX
	!error "RUNTIME_MAX is required (catalog runtime_range.verified_max)"
!endif

!define PROVIDER_ID   "ultraleap"
!define PROVIDER_DLL  "DisplayXR-Ultraleap.dll"
!define PROVIDER_KEY  "Software\DisplayXR\InputProviders\${PROVIDER_ID}"
!define OWN_KEY       "Software\DisplayXR\Plugins\Ultraleap"
!define ARP_KEY       "Software\Microsoft\Windows\CurrentVersion\Uninstall\DisplayXRUltraleap"
!define ALLOW_KEY     "Software\DisplayXR\Trust\Allowlist"
!define RUNTIME_KEY   "Software\DisplayXR\Runtime"
; The value the in-tree provider is documented at (input-provider-onboarding
; section 12: "the in-tree Ultraleap provider ships at 50").
!define PROBE_ORDER   50
; Where the provider looks for LeapC.dll by default (ultraleap_leapc.c) - the
; installer checks the same place, only to tell the user.
; TO VERIFY on a machine with the current Ultraleap software (docs/packaging.md).
!define LEAPC_DEFAULT_DIR "$PROGRAMFILES64\Ultraleap\LeapSDK\lib\x64"
!define LAYER_KEY     "SOFTWARE\Khronos\OpenXR\1\ApiLayers\Implicit"
!define LAYER_DISABLE_ENV "DISABLE_XR_APILAYER_ULTRALEAP_HAND_TRACKING_1"

;--------------------------------
; Code signing (empty SIGN_CMD = unsigned build).
!ifdef SIGN_CMD
	!if "${SIGN_CMD}" != ""
		!finalize '${SIGN_CMD} "%1"'
		!uninstfinalize '${SIGN_CMD} "%1"'
	!endif
!endif

Name "DisplayXR Ultraleap Hands ${VERSION}"
OutFile "${OUTPUT_DIR}\DisplayXRUltraleapSetup-${VERSION}.${BUILD_NUM}.exe"
InstallDir "$PROGRAMFILES64\DisplayXR\Plugins\Ultraleap"
InstallDirRegKey HKLM "${OWN_KEY}" "InstallPath"
RequestExecutionLevel admin
ShowInstDetails show
ShowUninstDetails show
; A silent install must never skip a locked file and exit 0.
AllowSkipFiles off

!include "MUI2.nsh"
!include "x64.nsh"
!include "LogicLib.nsh"
!include "FileFunc.nsh"
!include "WordFunc.nsh"
!include "${ALLOWLIST_NSH}"

!define MUI_ABORTWARNING

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "${SOURCE_DIR}\LICENSE"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Var ServiceWasRunning
Var Force          ; "1" when /FORCE was given

;--------------------------------
; Restart Manager: ask whoever maps our DLL (displayxr-service.exe, an
; in-process OpenXR app) to let go of it. In: $0 = full path of the file.

!macro UL_RELEASE_FILE UN
Function ${UN}UlReleaseFile
	Push $1
	Push $2
	Push $3
	Push $4
	Push $5
	${IfNot} ${FileExists} "$0"
		Goto release_done
	${EndIf}
	System::Call 'rstrtmgr::RmStartSession(*i .r1, i 0, w .r5) i .r2'
	${If} $2 != 0
		DetailPrint "Restart Manager unavailable (error $2)."
		Goto release_done
	${EndIf}
	System::Call '*(&w${NSIS_MAX_STRLEN} "$0") p .r3'
	System::Call '*(p r3) p .r4'
	System::Call 'rstrtmgr::RmRegisterResources(i r1, i 1, p r4, i 0, p 0, i 0, p 0) i .r2'
	System::Free $4
	System::Free $3
	${If} $2 == 0
		System::Call 'rstrtmgr::RmShutdown(i r1, i 1, p 0) i .r2'
		DetailPrint "Released $0 (RmShutdown result $2)."
	${Else}
		DetailPrint "Restart Manager could not register $0 (error $2)."
	${EndIf}
	System::Call 'rstrtmgr::RmEndSession(i r1)'
release_done:
	Pop $5
	Pop $4
	Pop $3
	Pop $2
	Pop $1
FunctionEnd
!macroend
!insertmacro UL_RELEASE_FILE ""
!insertmacro UL_RELEASE_FILE "un."

; $ServiceWasRunning = 1 if displayxr-service.exe is running now.
!macro UL_PROBE_SERVICE
	StrCpy $ServiceWasRunning 0
	nsExec::ExecToStack 'cmd.exe /c tasklist /FI "IMAGENAME eq displayxr-service.exe" /NH | find /I "displayxr-service.exe"'
	Pop $1 ; exit code: 0 = found
	Pop $2
	${If} $1 == 0
		StrCpy $ServiceWasRunning 1
	${EndIf}
!macroend

; Start the service again if we stopped it, and only through explorer.exe so it
; runs at the user's normal integrity, never elevated from this installer.
!macro UL_RESTORE_SERVICE
	${If} $ServiceWasRunning == 1
		StrCpy $1 0
		nsExec::ExecToStack 'cmd.exe /c tasklist /FI "IMAGENAME eq displayxr-service.exe" /NH | find /I "displayxr-service.exe"'
		Pop $1
		Pop $2
		${If} $1 != 0
			ReadRegStr $3 HKLM "${RUNTIME_KEY}" "InstallPath"
			${If} $3 != ""
			${AndIf} ${FileExists} "$3\displayxr-service.exe"
				DetailPrint "Starting the DisplayXR service at normal integrity..."
				Exec 'explorer.exe "$3\displayxr-service.exe"'
			${EndIf}
		${EndIf}
	${EndIf}
!macroend

;--------------------------------
; Ultraleap's implicit OpenXR layer. ADVISORY ONLY: the installer reads the
; registration and says what to do; it never changes the layer's registration
; or anybody's environment. $R9 = 1 when an enabled registration was found.

Function UlCheckImplicitLayer
	StrCpy $R9 0
	StrCpy $R0 0
	layer_loop:
		ClearErrors
		EnumRegValue $R1 HKLM "${LAYER_KEY}" $R0
		${If} ${Errors}
		${OrIf} $R1 == ""
			Goto layer_done
		${EndIf}
		IntOp $R0 $R0 + 1
		; Value name = manifest path; DWORD 0 = enabled.
		${WordFind} "$R1" "UltraleapHandTracking" "E+1{" $R2
		${IfNot} ${Errors}
			ReadRegDWORD $R3 HKLM "${LAYER_KEY}" "$R1"
			${If} $R3 == 0
				StrCpy $R9 1
				DetailPrint "NOTE: Ultraleap's implicit OpenXR layer is registered and enabled:"
				DetailPrint "      $R1"
			${EndIf}
		${EndIf}
		Goto layer_loop
	layer_done:
	${If} $R9 == 1
		DetailPrint "      For a Leap on the desk, set ${LAYER_DISABLE_ENV}=1 in the user"
		DetailPrint "      environment, close every OpenXR app, and set Desktop mode again in the"
		DetailPrint "      Ultraleap Control Panel. Otherwise the layer resets the tracking service"
		DetailPrint "      to Head-mounted mode in every OpenXR app and the hands come back swapped."
		MessageBox MB_ICONINFORMATION|MB_OK "Ultraleap's own OpenXR layer is enabled on this machine.$\r$\n$\r$\nIt loads into every OpenXR app and switches the Ultraleap tracking service to Head-mounted mode, which swaps left and right for a Leap on the desk.$\r$\n$\r$\nTo use the DisplayXR hands provider with a desk-mounted Leap: set the user environment variable ${LAYER_DISABLE_ENV}=1, close every OpenXR app, then select Desktop mode again in the Ultraleap Control Panel.$\r$\n$\r$\nThis installer did not change anything about that layer." /SD IDOK
	${EndIf}
FunctionEnd

;--------------------------------
; Installer

Section "Ultraleap hands provider" SecProvider
	SectionIn RO
	; NSIS is 32-bit; the runtime reads the 64-bit view.
	SetRegView 64

	!insertmacro UL_PROBE_SERVICE
	StrCpy $0 "$INSTDIR\${PROVIDER_DLL}"
	Call UlReleaseFile

	SetOutPath "$INSTDIR"
	File "${BIN_DIR}\plugins\${PROVIDER_DLL}"

	; --- The Ultraleap tracking software: looked for, never installed, never
	; copied. The provider binds LeapC.dll from there at run time.
	${If} ${FileExists} "${LEAPC_DEFAULT_DIR}\LeapC.dll"
		WriteRegStr HKLM "${OWN_KEY}" "UltraleapSoftware" "found"
		DetailPrint "Ultraleap tracking software found (${LEAPC_DEFAULT_DIR}\LeapC.dll)."
	${Else}
		WriteRegStr HKLM "${OWN_KEY}" "UltraleapSoftware" "not-found-at-install"
		DetailPrint "NOTE: the Ultraleap tracking software was not found (no LeapC.dll in"
		DetailPrint "      ${LEAPC_DEFAULT_DIR})."
		DetailPrint "      The provider is installed and will start working once the Ultraleap"
		DetailPrint "      tracking software is installed; until then DisplayXR keeps its keyboard"
		DetailPrint "      and mouse controllers. If it is installed somewhere else:"
		DetailPrint "      displayxr-cli input set ultraleap LEAPC_PATH <folder holding LeapC.dll>"
		MessageBox MB_ICONINFORMATION|MB_OK "The Ultraleap tracking software was not found on this machine.$\r$\n$\r$\nThe DisplayXR hands provider needs it and does not include it. Install it from Ultraleap; the provider starts working on its own afterwards. Until then DisplayXR keeps its keyboard and mouse controllers.$\r$\n$\r$\nIf it is installed in a non-default location, run:$\r$\ndisplayxr-cli input set ultraleap LEAPC_PATH <folder holding LeapC.dll>" /SD IDOK
	${EndIf}

	; --- Registration row (the runtime's public contract; ours alone) ---
	WriteRegStr   HKLM "${PROVIDER_KEY}" "Binary"      "$INSTDIR\${PROVIDER_DLL}"
	WriteRegStr   HKLM "${PROVIDER_KEY}" "DisplayName" "Ultraleap Hand Tracking (controller emulation)"
	WriteRegStr   HKLM "${PROVIDER_KEY}" "Vendor"      "DisplayXR"
	WriteRegDWORD HKLM "${PROVIDER_KEY}" "ProbeOrder"  ${PROBE_ORDER}
	WriteRegStr   HKLM "${PROVIDER_KEY}" "UninstallString" "$\"$INSTDIR\Uninstall.exe$\""
	; Version LAST: the "row complete" marker.
	WriteRegStr   HKLM "${PROVIDER_KEY}" "Version"     "${VERSION}"

	; --- Provenance: drop the row of the bytes a previous version installed,
	; then write the row for the bytes this one installed.
	ReadRegStr $1 HKLM "${OWN_KEY}" "AllowlistDigest"
	${If} $1 != ""
		DeleteRegValue HKLM "${ALLOW_KEY}" "$1"
	${EndIf}
	!insertmacro ULTRALEAP_ALLOWLIST_WRITE
	WriteRegStr HKLM "${OWN_KEY}" "AllowlistDigest" "${ULTRALEAP_ALLOWLIST_DIGEST}"

	WriteRegStr HKLM "${OWN_KEY}" "InstallPath" "$INSTDIR"
	WriteRegStr HKLM "${OWN_KEY}" "Version"     "${VERSION}"
	; The runtime this binary was built at, and the range it was verified for.
	WriteRegStr HKLM "${OWN_KEY}" "RuntimePin"  "${RUNTIME_PIN}"
	WriteRegStr HKLM "${OWN_KEY}" "RuntimeMin"  "${RUNTIME_MIN}"
	WriteRegStr HKLM "${OWN_KEY}" "RuntimeVerifiedMax" "${RUNTIME_MAX}"

	WriteUninstaller "$INSTDIR\Uninstall.exe"
	WriteRegStr   HKLM "${ARP_KEY}" "DisplayName"          "DisplayXR Ultraleap Hands"
	WriteRegStr   HKLM "${ARP_KEY}" "UninstallString"      "$\"$INSTDIR\Uninstall.exe$\""
	WriteRegStr   HKLM "${ARP_KEY}" "QuietUninstallString" "$\"$INSTDIR\Uninstall.exe$\" /S"
	WriteRegStr   HKLM "${ARP_KEY}" "Publisher"            "The DisplayXR Project"
	WriteRegStr   HKLM "${ARP_KEY}" "DisplayVersion"       "${VERSION}"
	WriteRegDWORD HKLM "${ARP_KEY}" "NoModify" 1
	WriteRegDWORD HKLM "${ARP_KEY}" "NoRepair" 1

	Call UlCheckImplicitLayer

	!insertmacro UL_RESTORE_SERVICE
SectionEnd

;--------------------------------
; Uninstaller - works with or without the runtime installed.

Section "Uninstall"
	SetRegView 64

	!insertmacro UL_PROBE_SERVICE
	; Drop the discovery row first so nothing picks the DLL up while it goes.
	DeleteRegKey HKLM "${PROVIDER_KEY}"

	StrCpy $0 "$INSTDIR\${PROVIDER_DLL}"
	Call un.UlReleaseFile
	Delete "$INSTDIR\${PROVIDER_DLL}"
	Delete "$INSTDIR\Uninstall.exe"
	RMDir "$INSTDIR"
	RMDir "$PROGRAMFILES64\DisplayXR\Plugins"

	; Our allowlist row, and only ours.
	!insertmacro ULTRALEAP_ALLOWLIST_REMOVE
	ReadRegStr $1 HKLM "${OWN_KEY}" "AllowlistDigest"
	${If} $1 != ""
		DeleteRegValue HKLM "${ALLOW_KEY}" "$1"
	${EndIf}
	DeleteRegKey /ifempty HKLM "${ALLOW_KEY}"

	DeleteRegKey HKLM "${OWN_KEY}"
	DeleteRegKey /ifempty HKLM "Software\DisplayXR\Plugins"
	DeleteRegKey HKLM "${ARP_KEY}"

	!insertmacro UL_RESTORE_SERVICE
SectionEnd

Function .onInit
	${IfNot} ${RunningX64}
		MessageBox MB_ICONSTOP "This provider requires 64-bit Windows." /SD IDOK
		Abort
	${EndIf}
	SetRegView 64

	; --- Command line: /FORCE ------------------------------------------
	StrCpy $Force "0"
	${GetParameters} $R0
	ClearErrors
	${GetOptions} $R0 "/FORCE" $R1
	${IfNot} ${Errors}
		StrCpy $Force "1"
	${EndIf}
	ClearErrors

	; --- Runtime range. Checked only when a runtime is installed: the
	; provider has no install-order requirement. -----------------------
	ReadRegStr $R2 HKLM "${RUNTIME_KEY}" "Version"
	${If} $R2 != ""
		; Compare on X.Y.Z; the runtime may record a fourth component.
		${WordFind} "$R2" "." "+1" $R3
		${WordFind} "$R2" "." "+2" $R4
		${WordFind} "$R2" "." "+3" $R5
		StrCpy $R6 "$R3.$R4.$R5"
		; $R7: 0 equal, 1 installed newer, 2 installed older.
		${VersionCompare} "$R6" "${RUNTIME_MIN}" $R7
		${If} $R7 == 2
		${AndIf} $Force != "1"
			MessageBox MB_ICONSTOP|MB_OK "This build of the DisplayXR Ultraleap provider needs DisplayXR Runtime ${RUNTIME_MIN} or newer.$\r$\n$\r$\nThis machine has runtime $R2. Update the runtime, then run this installer again.$\r$\n$\r$\n(/FORCE installs anyway - for developers.)" /SD IDOK
			SetErrorLevel 3
			Quit
		${EndIf}
		${VersionCompare} "$R6" "${RUNTIME_MAX}" $R7
		${If} $R7 == 1
			; Newer than this build was verified for: not known bad. Say so, go on.
			MessageBox MB_ICONINFORMATION|MB_OK "DisplayXR Runtime $R2 is newer than the releases this build of the Ultraleap provider was verified for (${RUNTIME_MIN} to ${RUNTIME_MAX}).$\r$\n$\r$\nIt will be installed. If hand tracking misbehaves, install the newest DisplayXR Ultraleap release." /SD IDOK
		${EndIf}
	${EndIf}
FunctionEnd

Function un.onInit
	SetRegView 64
FunctionEnd

VIProductVersion "${VERSION_MAJOR}.${VERSION_MINOR}.${VERSION_PATCH}.0"
VIAddVersionKey "ProductName" "DisplayXR Ultraleap Hands"
VIAddVersionKey "CompanyName" "The DisplayXR Project"
VIAddVersionKey "LegalCopyright" "Copyright (c) 2026 The DisplayXR Project"
VIAddVersionKey "FileDescription" "DisplayXR Ultraleap Hands Input Provider Installer"
VIAddVersionKey "FileVersion" "${VERSION}"
VIAddVersionKey "ProductVersion" "${VERSION}"
